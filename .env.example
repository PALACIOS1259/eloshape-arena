# Public / authenticated Supabase connection values.
# These are safe to expose to the browser when RLS is configured correctly.
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Server-only Riot API key. Never prefix with VITE_.
# Prefer configuring this in Lovable Cloud for the published app.
RIOT_API_KEY=""

# Optional explicit mock mode for local UI development only.
# RIOT_MOCK_MODE="1"

# Do NOT copy Lovable-managed privileged credentials into client-side env vars.
# A standalone trusted backend may set SUPABASE_SERVICE_ROLE_KEY server-side,
# but normal dashboard/profile/location flows do not require it.
