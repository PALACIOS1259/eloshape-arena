# Public / authenticated Supabase connection values.
# These are safe to expose to the browser when RLS is configured correctly.
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Riot writes now run in the authenticated Supabase Edge Function `riot-sync`.
# DO NOT put RIOT_API_KEY in this app env or prefix it with VITE_.
# Add RIOT_API_KEY directly in Supabase Dashboard -> Edge Functions -> Secrets.

# Supabase injects its own trusted backend credentials into hosted Edge Functions.
# Never copy SUPABASE_SERVICE_ROLE_KEY / sb_secret_* into the browser or this file.
