# Set this to the canonical public origin for each deployment, without a trailing slash.
# Example: https://www.example.com
# Leave it unset for localhost until the final EloShape domain is selected.
VITE_SITE_URL=""

# Set to "true" on production while public registration is closed.
# Keep unset or "false" in development and staging so the full app remains testable.
VITE_MAINTENANCE_MODE="false"

# Optional direct HTTPS URL for the homepage introduction MP4.
# The section remains hidden until this value is configured.
VITE_INTRO_VIDEO_URL=""

# Riot writes run in the authenticated Supabase Edge Function `riot-sync`.
# DO NOT put RIOT_API_KEY in this app env or prefix it with VITE_.
# RIOT_API_KEY belongs only in Supabase Dashboard -> Edge Functions -> Secrets.

# Supabase injects trusted backend credentials into hosted Edge Functions.
# Never copy SUPABASE_SERVICE_ROLE_KEY / sb_secret_* into the browser or this file.
